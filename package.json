{
  "name": "apex-solutions",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "main": "main.electron.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "package:sh": "echo '#!/bin/bash\n# Portable Apex Solutions Bootstrap\nnpm install && npm run build && npm run start' > apex-launcher.sh && chmod +x apex-launcher.sh"
  },
  "build": {
    "asar": false,
    "appId": "com.apex.solutions",
    "productName": "Apex Solutions",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.electron.cjs",
      "preload.cjs",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Apex-Solutions.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apex Solutions"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Apex-Solutions.dmg"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
